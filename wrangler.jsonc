{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkly-erp-sync",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: the app calls its own public URL (simulated ERP API and its callback),
  // which a Worker can only do when fetch goes out through the internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inkly-erp-sync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
